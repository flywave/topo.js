{
    "name": "topo.js",
    "private": true,
    "type": "module",
    "workspaces": [
      "packages/*"
    ],
    "scripts": {
      "build": "make",
      "rebuild": "make rebuild",
      "wasm": "make rebuild",
      "dev": "pnpm --filter topo-example dev",
      "start": "pnpm --filter topo-example dev",
      "example": "pnpm --filter topo-example build",
