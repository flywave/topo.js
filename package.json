      "build:example": "pnpm --filter topo-example build",
      "prepare-packages": "lerna exec pnpm build --no-private --no-bail",
      "publish-packages": "lerna publish"
    },
    "devDependencies": {
      "eslint": "^8.1.0",
      "lerna": "7.1.5",
      "prettier": "^2.4.1"
